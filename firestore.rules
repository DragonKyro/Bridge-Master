rules_version = '2';

// Firestore in the shared project github-games-e7c7d. Bridge Master was the
// first app here to use Firestore, so this file is the project's whole rules
// set: an app adding Firestore later must merge its rules into this file
// (deploying replaces every rule).
service cloud.firestore {
  match /databases/{database}/documents {
    // Bridge Master progress: one document per signed-in user, readable and
    // writable only by that user. { deals: { "1A-7": { b, t, at } }, updated }
    match /bridgeMaster/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['deals', 'updated'])
        && request.resource.data.deals is map;
    }
  }
}
